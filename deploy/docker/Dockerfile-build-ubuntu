# The base must stay on 22.04. The AppImage links against the build system's
# glibc, and glibc is forward-compatible only, so building on 2.35 keeps the
# artifact runnable on 22.04 and every later release. Raising the base would
# silently drop support for older hosts.
FROM ubuntu:22.04

ARG QT_VERSION=6.8.3
ARG QT_MODULES="qtcharts qtlocation qtpositioning qtspeech qt5compat qtmultimedia qtserialport qtimageformats qtshadertools qtconnectivity qtquick3d qtsensors"

ENV DEBIAN_FRONTEND=noninteractive

ENV QT_PATH=/opt/Qt
ENV QT_DESKTOP=${QT_PATH}/${QT_VERSION}/gcc_64
ENV PATH=${QT_DESKTOP}/bin:${PATH}

# linuxdeploy and appimagetool ship as AppImages. Extracting them instead of
# mounting them over FUSE lets the container run unprivileged.
ENV APPIMAGE_EXTRACT_AND_RUN=1

# Trusts the bind-mounted source tree for any uid, unlike `git config --global`,
# which would only cover root.
ENV GIT_CONFIG_COUNT=1
ENV GIT_CONFIG_KEY_0=safe.directory
ENV GIT_CONFIG_VALUE_0=/project/source

# Override at run time with `docker run --env QGC_BUILD_TYPE=Debug`.
ENV QGC_BUILD_TYPE=Release

# Qt is installed before the dependency layer so that editing the dependency
# script does not invalidate the multi-gigabyte Qt download.
COPY tools/setup/install-qt-debian.sh /tmp/setup/
RUN /tmp/setup/install-qt-debian.sh \
    && rm -rf /root/.cache/pip /var/lib/apt/lists/*

COPY tools/setup/install-dependencies-debian.sh /tmp/setup/
RUN /tmp/setup/install-dependencies-debian.sh \
    && locale-gen en_US.UTF-8 \
    && dpkg-reconfigure locales \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/setup

WORKDIR /project/build

# Chained with && so a configure or compile failure fails the container. The
# previous `;` form returned the exit status of the install step alone, which
# let broken builds report success.
CMD cmake -S /project/source -B . -G Ninja -DCMAKE_BUILD_TYPE=${QGC_BUILD_TYPE} \
    && cmake --build . --target all \
    && cmake --install .
